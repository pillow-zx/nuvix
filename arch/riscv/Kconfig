menu "Platform"

config ARCH_RISCV
	bool
	default y

config PLATFORM_QEMU_VIRT
	bool
	default y

comment "QEMU virt is the only supported platform in this stage."

config DRAM_SIZE_MB
	int "DRAM size (MiB)"
	range 64 1024
	default 256
	help
	  Current early boot page tables cover the 1 GiB window starting at
	  DRAM_BASE, so larger memory sizes require boot mapping changes.

config QEMU_CPUS
	int "QEMU CPU count"
	range 1 8
	default 1
	help
	  Number of QEMU virt harts to boot. Controls both QEMU -smp and the
	  exact number of required kernel CPUs: every configured hart must
	  reach its idle loop through SBI HSM or the kernel panics. The virt
	  platform table enumerates harts 0..7; the first N entries are
	  required.

endmenu
