BEGIN {
    print "/* Automatically generated by scripts/gen-offsets.awk; DO NOT EDIT. */"
    print "#ifndef _NUVIX_GENERATED_OFFSETS_H"
    print "#define _NUVIX_GENERATED_OFFSETS_H"
    print ""
}

/^[[:space:]]*\.ascii[[:space:]]+"->[A-Z_][A-Z_0-9]* -?[0-9]+"[[:space:]]*$/ {
    sub(/^"->/, "", $2)
    sub(/"$/, "", $3)
    print "#define " $2 " " $3
    count++
}

END {
    if (!count) {
        print "No asm-offsets markers found in " FILENAME > "/dev/stderr"
        exit 1
    }
    print ""
    print "#endif /* _NUVIX_GENERATED_OFFSETS_H */"
}
