menu "Device Drivers"

config VIRTIO
	bool "virtio-drivers"
	default y

config VIRTIO_BLK
	depends on VIRTIO
	bool "virtio-blk"
	default y

config VIRTIO_RNG
	depends on VIRTIO
	bool "virtio-rng"
	default y

config VIRTIO_SND
	depends on VIRTIO
	bool "virtio-snd"
	default y
	help
	  Play signed 16-bit little-endian PCM through /dev/audio.
	
endmenu
