config SMP
	bool "SMP subsystem support"
	default n

config NR_CPUS
	int "Maximum supported CPU count" if SMP
	range 1 64
	default 1 if !SMP
	default 8
	help
	  Capacity of static CPU arrays. The DTB supplies the actual topology.
	  Enabled harts beyond this capacity are not started and are reported.
	  UP uses only the boot hart. Hart IDs need not be contiguous.

config SCHED_QUANTUM_MS
	int "Round-robin time slice (ms)"
	range 1 1000
	default 10

config SMP_BOOT_TIMEOUT_MS
	int "All-CPU startup timeout (ms)"
	depends on SMP
	range 1 60000
	default 1000

config FUTEX
	bool "Futex subsystem support"
	default n

config NR_FUTEX_BUCKETS
	int "Number of futex hash buckets"
	depends on FUTEX
	default 32
	help
	  Number of buckets in the futex wait-queue hash table.
	  Must be a positive power of two.
